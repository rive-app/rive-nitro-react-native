        <StateMachine name="State Machine 1" id="0:27">
            <StateMachineLayer name="Trigger" id="0:28">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:212"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:231" id="0:212">
                    <StateTransition stateToId="0:213">
                        <TransitionViewModelCondition opValue="equal">
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:40-0:46" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
